{
  "expo": {
    "name": "玉桂狗日记",
    "slug": "cinnamoroll-app",
    "version": "1.7.0",
    "orientation": "portrait",
    "icon": "./assets/images/cinnamoroll-logo.png",
    "scheme": "cinnamoroll",
    "userInterfaceStyle": "light",
    "splash": {
      "image": "./assets/images/cinnamoroll-logo.png",
      "resizeMode": "contain",
      "backgroundColor": "#E8F4FD"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.cinnamoroll.app"
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/cinnamoroll-logo.png",
        "backgroundColor": "#E8F4FD"
      },
      "package": "com.cinnamoroll.app",
      "versionCode": 2,
      "permissions": [
        "REQUEST_INSTALL_PACKAGES"
      ]
    },
    "web": {
      "bundler": "metro",
      "output": "static"
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      "expo-sharing"
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
